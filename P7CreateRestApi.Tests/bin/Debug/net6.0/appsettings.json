        "Name": "File",
        "Args": {
          "path": "Logs/log.txt",
          "rollingInterval": "Day",
          "shared": true
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },

  "Jwt": {
    "Key": "9F7A3E6D1C4B8A2E5F0D9C6A7B4E1F3A8C2D5E9B0A6F4C7D1E8A9B3",
    "Issuer": "P7CreateRestApi",
